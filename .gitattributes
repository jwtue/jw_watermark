# Files excluded from the distributed extension archive (TER ZIP / git archive).
# `git archive` and the release workflow honour these export-ignore rules, so the
# package contains only what a TYPO3 installation needs — no CI/dev metadata.
/.github        export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/AGENTS.md      export-ignore
/.editorconfig  export-ignore
/.git-blame-ignore-revs export-ignore
/.php-cs-fixer.dist.php export-ignore

# Text files are stored with LF line endings. A Windows checkout may still use
# CRLF locally via core.autocrlf — that is fine, the normalisation happens on the
# way into the repository. The icons must never be touched by it.
*               text=auto
*.gif           binary
*.png           binary
